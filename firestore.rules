rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'kdeepakrajak@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isValidWish(data) {
      return data.keys().hasAll(['name', 'relation', 'text', 'avatar', 'createdAt'])
        && data.keys().hasOnly(['name', 'relation', 'text', 'avatar', 'createdAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.relation is string && data.relation.size() >= 1 && data.relation.size() <= 50
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 500
        && data.avatar is string && data.avatar.size() >= 1 && data.avatar.size() <= 4
        && data.createdAt is timestamp && data.createdAt == request.time;
    }

    // Public shared guestbook wishes wall
    match /wishes/{wishId} {
      allow get: if isValidId(wishId);
      allow list: if true;
      allow create: if isValidId(wishId) && isValidWish(incoming());
      allow update: if false;
      allow delete: if isValidId(wishId) && isAdmin();
    }

    // Admin registry (read-only self-check)
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isSignedIn() && request.auth.uid == adminId;
      allow list, write: if false;
    }
  }
}
